---
interface Props {
  html: string;
  css?: string;
  js?: string;
  /** Fills the viewport and loads files handed over by another instance's Open button. */
  standalone?: boolean;
}

const { html, css, js, standalone = false } = Astro.props;

// One tab per supplied file; CSS and JS tabs only exist when passed in.
const files: [string, string][] = [['index.html', html]];
if (css != null) files.push(['style.css', css]);
if (js != null) files.push(['script.js', js]);

// Escape "<" so file contents can't close the JSON <script> tag early.
const filesJson = JSON.stringify(files).replace(/</g, '\\u003c');
const uid = Math.random().toString(36).slice(2, 10);
const logId = `cp-log-${uid}`;
const stageId = `cp-stage-${uid}`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
/>

<div class={standalone ? 'code-preview standalone' : 'code-preview'}>
  <script
    is:inline
    type="application/json"
    data-cp="files"
    set:html={filesJson}
  />
  <div class="work console-collapsed" data-cp="work">
    <section class="pane editor-pane" aria-label="Editor">
      <div class="tabs" data-cp="tabs" role="tablist"></div>
      <div class="editor-wrap">
        <div class="editor" data-cp="editor"></div>
        <div class="editor-msg" data-cp="editor-msg">Loading Monaco…</div>
      </div>
      <div class="editor-status">
        <span data-cp="st-lang">—</span>
        <span data-cp="st-pos"></span>
        <span class="sp" data-cp="st-size"></span>
      </div>
    </section>

    <section class="pane preview-pane" aria-label="Preview">
      <div class="pane-head">
        <button
          class="icon-btn preview-toggle"
          data-cp="preview-toggle"
          type="button"
          aria-expanded="true"
          aria-controls={stageId}
          title="Hide preview"
          aria-label="Hide preview"
        >
          <svg
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"></path></svg
          >
        </button>
        <span class="status-dot" data-cp="run-dot"></span>
        <span class="label">Preview</span>
        <button
          class="btn btn-sm btn-open"
          data-cp="open"
          type="button"
          title="Open this editor in a new tab"
          hidden={standalone}
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M9.5 2.5h4v4M13.5 2.5 7.5 8.5M11.5 9.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3"
            ></path></svg
          >
          Open
        </button>
        <button
          class="btn btn-sm"
          data-cp="export"
          type="button"
          title="Download the combined page as export.html"
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path
              d="M8 2v8M4.5 6.8 8 10.3l3.5-3.5M2.5 11.5v1.5a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-1.5"
            ></path></svg
          >
          Export
        </button>
        <button class="btn btn-sm btn-reload" data-cp="reload" type="button" title="Rebuild the preview">
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5v3h-3"></path></svg
          >
          Refresh
        </button>
      </div>
      <div class="preview-stage" id={stageId}>
        <iframe
          class="preview-frame"
          data-cp="preview"
          title="Preview of your page"
          sandbox="allow-scripts allow-forms"></iframe>
      </div>
      <div class="pane-foot">
        <div class="zoom" role="group" aria-label="Preview scale">
          <button class="zoom-btn" type="button" data-z="1" aria-pressed="false">1x</button>
          <button class="zoom-btn" type="button" data-z="0.5" aria-pressed="true">0.5x</button>
          <button class="zoom-btn" type="button" data-z="0.25" aria-pressed="false">0.25x</button>
        </div>
      </div>
    </section>

    <section class="pane console-pane" aria-label="Console">
      <div class="pane-head">
        <button
          class="console-toggle"
          data-cp="console-toggle"
          type="button"
          aria-expanded="false"
          aria-controls={logId}
          title="Show console"
        >
          <svg
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"></path></svg
          >
          <span class="label">Console</span>
        </button>
        <div class="filters" role="group" aria-label="Filter console">
          <button class="filter" type="button" data-f="all" aria-pressed="true"
            >All <span class="n" data-n="all">0</span></button
          >
          <button class="filter" type="button" data-f="log" aria-pressed="false"
            >Logs <span class="n" data-n="log">0</span></button
          >
          <button
            class="filter"
            type="button"
            data-f="warn"
            aria-pressed="false"
            >Warnings <span class="n warn" data-n="warn">0</span></button
          >
          <button
            class="filter"
            type="button"
            data-f="error"
            aria-pressed="false"
            >Errors <span class="n error" data-n="error">0</span></button
          >
        </div>
        <button
          class="icon-btn"
          data-cp="clear"
          type="button"
          title="Clear console"
          aria-label="Clear console"
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            ><circle cx="8" cy="8" r="5.5"></circle><path d="M4.2 11.8l7.6-7.6"
            ></path></svg
          >
        </button>
      </div>
      <div
        class="log"
        id={logId}
        data-cp="log"
        role="log"
        aria-live="polite"
        hidden
      >
      </div>
    </section>
  </div>
  <div class="toast" data-cp="toast" hidden></div>
</div>

<script>
  const MONACO_BASE = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/';
  const DOMPURIFY_SRC =
    'https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js';

  declare global {
    interface Window {
      DOMPurify?: any;
      MonacoEnvironment?: any;
      require?: any;
    }
  }

  /* ---------- Shared loaders (one network fetch per page, however many instances) ---------- */
  const scriptCache: Record<string, Promise<void>> = {};
  function loadScript(src: string) {
    return (scriptCache[src] ||= new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('failed to load ' + src));
      document.head.appendChild(s);
    }));
  }

  // DOMPurify must load before Monaco's AMD loader, or it registers as an AMD module instead of window.DOMPurify.
  function loadPurify() {
    return loadScript(DOMPURIFY_SRC);
  }

  let monacoP: Promise<any> | null = null;
  function loadMonaco() {
    return (monacoP ||= loadPurify()
      .catch(() => {})
      .then(() => loadScript(MONACO_BASE + 'vs/loader.js'))
      .then(
        () =>
          new Promise((resolve, reject) => {
            const req = window.require;
            if (typeof req !== 'function' || !req.config)
              throw new Error('loader unavailable');
            const workerSrc =
              "self.MonacoEnvironment={baseUrl:'" +
              MONACO_BASE +
              "'};importScripts('" +
              MONACO_BASE +
              "vs/base/worker/workerMain.js');";
            window.MonacoEnvironment = {
              getWorkerUrl: () =>
                URL.createObjectURL(
                  new Blob([workerSrc], { type: 'text/javascript' }),
                ),
            };
            req.config({ paths: { vs: MONACO_BASE + 'vs' } });
            req(['vs/editor/editor.main'], resolve, reject);
          }),
      ));
  }

  /* File-type logos (paths from Simple Icons, CC0) */
  const LOGOS: Record<string, { fill: string; under: string; d: string }> = {
    html: {
      fill: '#E34F26',
      under:
        '<path fill="#fff" d="M3.2 1.5h17.6l-1.6 18.4L12 22.3l-7.2-2.1z"/>',
      d: 'M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z',
    },
    css: {
      fill: '#1572B6',
      under:
        '<path fill="#fff" d="M3.2 1.5h17.6l-1.6 18.4L12 22.3l-7.2-2.1z"/>',
      d: 'M1.5 0h21l-1.91 21.563L11.977 24l-8.565-2.438L1.5 0zm17.09 4.413L5.41 4.41l.213 2.622 10.125.002-.255 2.716h-6.64l.24 2.573h6.182l-.366 3.523-2.91.804-2.956-.81-.188-2.11h-2.61l.29 3.855L12 19.288l5.373-1.53L18.59 4.414z',
    },
    js: {
      fill: '#F7DF1E',
      under: '<rect x="1" y="1" width="22" height="22" fill="#000"/>',
      d: 'M0 0h24v24H0V0zm22.034 18.276c-.175-1.095-.888-2.015-3.003-2.873-.736-.345-1.554-.585-1.797-1.14-.091-.33-.105-.51-.046-.705.15-.646.915-.84 1.515-.66.39.12.75.42.976.9 1.034-.676 1.034-.676 1.755-1.125-.27-.42-.404-.601-.586-.78-.63-.705-1.469-1.065-2.834-1.034l-.705.089c-.676.165-1.32.525-1.71 1.005-1.14 1.291-.811 3.541.569 4.471 1.365 1.02 3.361 1.244 3.616 2.205.24 1.17-.87 1.545-1.966 1.41-.811-.18-1.26-.586-1.755-1.336l-1.83 1.051c.21.48.45.689.81 1.109 1.74 1.756 6.09 1.666 6.871-1.004.029-.09.24-.705.074-1.65l.046.067zm-8.983-7.245h-2.248c0 1.938-.009 3.864-.009 5.805 0 1.232.063 2.363-.138 2.711-.33.689-1.18.601-1.566.48-.396-.196-.597-.466-.83-.855-.063-.105-.11-.196-.127-.196l-1.825 1.125c.305.63.75 1.172 1.324 1.517.855.51 2.004.675 3.207.405.783-.226 1.458-.691 1.811-1.411.51-.93.402-2.07.397-3.346.012-2.054 0-4.109 0-6.179l.004-.056z',
    },
  };
  function logoSvg(type: string) {
    const L = LOGOS[type];
    if (!L) return '';
    return (
      '<svg viewBox="0 0 24 24" aria-hidden="true">' +
      L.under +
      '<path fill="' +
      L.fill +
      '" d="' +
      L.d +
      '"/></svg>'
    );
  }

  function ext(name: string) {
    const m = /\.(html|css|js)$/i.exec(name);
    return m ? m[1].toLowerCase() : 'txt';
  }
  function langOf(name: string) {
    return (
      (
        { html: 'html', css: 'css', js: 'javascript' } as Record<string, string>
      )[ext(name)] || 'plaintext'
    );
  }
  function langLabel(name: string) {
    return (
      (
        { html: 'HTML', css: 'CSS', js: 'JavaScript' } as Record<string, string>
      )[ext(name)] || 'Text'
    );
  }
  function fmtBytes(n: number) {
    return n < 1024 ? n + ' B' : (n / 1024).toFixed(1) + ' KB';
  }
  function byteLen(s: string) {
    try {
      return new Blob([s]).size;
    } catch (e) {
      return s.length;
    }
  }

  /* Runs inside the preview iframe: forwards console output and errors to the parent. */
  function bridge(T: string, FILES: string[]) {
    const send = function (level: string, args: any[], loc?: any) {
      try {
        parent.postMessage(
          { __mc: T, level: level, args: args, loc: loc || null },
          '*',
        );
      } catch (e) {}
    };
    function fmt(v: any, d: number, seen: any[]): string {
      const t = typeof v;
      if (v === null) return 'null';
      if (t === 'undefined') return 'undefined';
      if (t === 'string') return d === 0 ? v : JSON.stringify(v);
      if (t === 'number' || t === 'boolean') return String(v);
      if (t === 'bigint') return v + 'n';
      if (t === 'symbol') return v.toString();
      if (t === 'function') return 'ƒ ' + (v.name || 'anonymous') + '()';
      if (v instanceof Error) return v.name + ': ' + v.message;
      if (typeof Element !== 'undefined' && v instanceof Element) {
        let s = '<' + v.tagName.toLowerCase();
        if (v.id) s += '#' + v.id;
        if (v.className && typeof v.className === 'string')
          s += '.' + v.className.trim().split(/\s+/).join('.');
        return s + '>';
      }
      if (seen.indexOf(v) !== -1) return '[Circular]';
      if (d > 2) return Array.isArray(v) ? '[…]' : '{…}';
      seen = seen.concat([v]);
      let out, keys;
      if (Array.isArray(v)) {
        out = v.slice(0, 50).map(function (x) {
          return fmt(x, d + 1, seen);
        });
        if (v.length > 50) out.push('… ' + (v.length - 50) + ' more');
        return '[' + out.join(', ') + ']';
      }
      if (v instanceof Map) return 'Map(' + v.size + ')';
      if (v instanceof Set) return 'Set(' + v.size + ')';
      if (v instanceof Date) return v.toISOString();
      try {
        keys = Object.keys(v);
      } catch (e) {
        return '{…}';
      }
      out = keys.slice(0, 30).map(function (k) {
        let val;
        try {
          val = v[k];
        } catch (e) {
          val = '[getter error]';
        }
        return k + ': ' + fmt(val, d + 1, seen);
      });
      if (keys.length > 30) out.push('…');
      const ctor =
        v.constructor && v.constructor.name && v.constructor.name !== 'Object'
          ? v.constructor.name + ' '
          : '';
      return ctor + '{' + out.join(', ') + '}';
    }
    function kind(v: any) {
      if (v === null) return 'null';
      const t = typeof v;
      if (t === 'undefined') return 'undef';
      if (t === 'number' || t === 'bigint') return 'num';
      if (t === 'boolean') return 'bool';
      if (t === 'function') return 'fn';
      if (t === 'string') return 'str';
      return 'obj';
    }
    function locFromStack(stack: any) {
      if (!stack) return null;
      const re = /([\w.-]+\.js):(\d+):(\d+)/g;
      let m;
      while ((m = re.exec(stack))) {
        if (FILES.indexOf(m[1]) !== -1)
          return { file: m[1], line: +m[2], col: +m[3] };
      }
      return null;
    }
    function pack(args: ArrayLike<any>) {
      let loc: any = null;
      const out = Array.prototype.map.call(args, function (a: any) {
        const item: any = { k: kind(a), s: fmt(a, 0, []) };
        if (a instanceof Error) {
          item.k = 'err';
          item.stack = a.stack
            ? String(a.stack).split('\n').slice(1, 4).join('\n')
            : '';
          loc = loc || locFromStack(a.stack);
        }
        return item;
      });
      return { args: out, loc: loc };
    }
    ['log', 'info', 'warn', 'error', 'debug', 'table'].forEach(function (k) {
      const orig = (console as any)[k];
      (console as any)[k] = function () {
        const p = pack(arguments);
        send(k === 'debug' || k === 'table' ? 'log' : k, p.args, p.loc);
        try {
          orig && orig.apply(console, arguments);
        } catch (e) {}
      };
    });
    const origClear = console.clear;
    console.clear = function () {
      send('clear', []);
      try {
        origClear && origClear.call(console);
      } catch (e) {}
    };
    window.addEventListener('error', function (e) {
      let loc = (e.error && locFromStack(e.error.stack)) || null;
      if (!loc && e.filename) {
        const f = String(e.filename).split('/').pop() as string;
        if (FILES.indexOf(f) !== -1)
          loc = { file: f, line: e.lineno, col: e.colno };
      }
      let msg = e.message || 'Script error';
      if (!loc && e.lineno)
        msg += '  (line ' + e.lineno + ' of the built page)';
      send('error', [{ k: 'str', s: msg }], loc);
    });
    window.addEventListener('unhandledrejection', function (e) {
      const p = pack(['Uncaught (in promise)', e.reason]);
      send('error', p.args, p.loc);
    });
  }

  let instanceCount = 0;

  /* Open-in-new-tab handoff: the opener stashes its files in localStorage under a key passed in the URL hash.
     The new tab moves them to sessionStorage so a reload keeps them. */
  const HANDOFF_PREFIX = 'cp-open-';
  function readHandoff(): [string, string][] | null {
    const key = location.hash.slice(1);
    if (!key.startsWith(HANDOFF_PREFIX)) return null;
    try {
      let raw = localStorage.getItem(key);
      if (raw != null) {
        localStorage.removeItem(key);
        sessionStorage.setItem(key, raw);
      } else {
        raw = sessionStorage.getItem(key);
      }
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function init(root: HTMLElement) {
    const instance = ++instanceCount;
    const $ = <T extends HTMLElement = HTMLElement>(name: string) =>
      root.querySelector('[data-cp="' + name + '"]') as T;

    const source: [string, string][] =
      (root.classList.contains('standalone') && readHandoff()) ||
      JSON.parse($('files').textContent || '[]');
    const state = {
      files: source.map(([name, content]) => ({ name, content })),
      active: 'index.html',
    };
    function getFile(name: string) {
      return state.files.find((f) => f.name === name) || null;
    }

    const elTabs = $('tabs');
    const elLog = $('log');
    const frame = $<HTMLIFrameElement>('preview');

    /* ---------- Tabs (one per supplied file) ---------- */
    function renderTabs() {
      elTabs.innerHTML = '';
      state.files.forEach((f) => {
        const name = f.name;
        const t = document.createElement('div');
        t.className = 'tab' + (name === state.active ? ' active' : '');
        t.setAttribute('role', 'tab');
        t.setAttribute(
          'aria-selected',
          name === state.active ? 'true' : 'false',
        );
        t.tabIndex = 0;
        const icon = document.createElement('span');
        icon.className = 'ficon';
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = logoSvg(ext(name));
        const label = document.createElement('span');
        label.textContent = name;
        t.append(icon, label);
        t.addEventListener('click', () => openFile(name));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openFile(name);
          }
        });
        elTabs.appendChild(t);
      });
    }

    /* ---------- Editor (Monaco with a textarea fallback) ---------- */
    let monacoRef: any = null,
      editor: any = null,
      fallback: HTMLTextAreaElement | null = null;
    const models: Record<string, any> = {},
      viewStates: Record<string, any> = {};

    function openFile(name: string) {
      if (!getFile(name)) return;
      const prev = state.active;
      if (editor && prev && models[prev] && prev !== name)
        viewStates[prev] = editor.saveViewState();
      state.active = name;
      if (editor) {
        editor.setModel(models[name]);
        if (viewStates[name]) editor.restoreViewState(viewStates[name]);
        editor.focus();
      } else if (fallback) {
        fallback.value = getFile(name)!.content;
      }
      renderTabs();
      updateStatus();
    }
    function updateStatus() {
      const f = getFile(state.active);
      $('st-lang').textContent = f ? langLabel(f.name) : '—';
      $('st-size').textContent = f
        ? f.content.split('\n').length +
          ' lines · ' +
          fmtBytes(byteLen(f.content))
        : '';
      if (editor) {
        const p = editor.getPosition();
        $('st-pos').textContent = p
          ? 'Ln ' + p.lineNumber + ', Col ' + p.column
          : '';
      } else $('st-pos').textContent = '';
    }
    function onContentChanged(name: string, value: string) {
      const f = getFile(name);
      if (!f) return;
      f.content = value;
      if (name === state.active) updateStatus();
      scheduleRun();
    }
    function createModel(name: string, content: string) {
      const m = monacoRef.editor.createModel(
        content,
        langOf(name),
        monacoRef.Uri.parse('file:///code-preview-' + instance + '/' + name),
      );
      m.onDidChangeContent(() => onContentChanged(name, m.getValue()));
      models[name] = m;
      return m;
    }
    function cssVar(n: string) {
      return getComputedStyle($('editor')).getPropertyValue(n).trim();
    }
    function applyMonacoTheme() {
      if (!monacoRef) return;
      monacoRef.editor.defineTheme('code-preview', {
        base: 'vs-dark',
        inherit: true,
        rules: [],
        colors: {
          'editor.background': cssVar('--editor-bg'),
          'editor.lineHighlightBackground': cssVar('--editor-line'),
          'editorLineNumber.foreground': cssVar('--muted'),
          'editorLineNumber.activeForeground': cssVar('--ink'),
          'editorCursor.foreground': cssVar('--accent'),
          'editorGutter.background': cssVar('--editor-bg'),
          'minimap.background': cssVar('--editor-bg'),
        },
      });
      monacoRef.editor.setTheme('code-preview');
    }

    function startFallback(reason: string) {
      if (editor || fallback) return;
      $('editor-msg').hidden = true;
      const ta = (fallback = document.createElement('textarea'));
      ta.className = 'fallback';
      ta.spellcheck = false;
      ta.setAttribute('aria-label', 'Code editor');
      ta.value = getFile(state.active)!.content;
      ta.addEventListener('input', () =>
        onContentChanged(state.active, ta.value),
      );
      ta.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          ta.setRangeText('  ', ta.selectionStart, ta.selectionEnd, 'end');
          onContentChanged(state.active, ta.value);
        }
      });
      $('editor').appendChild(ta);
      logSys(
        "Monaco couldn't load (" +
          reason +
          '), so a plain text editor is in use. Everything else works the same.',
      );
    }

    function bootMonaco() {
      const timeout = setTimeout(() => startFallback('timed out'), 20000);
      const fontReady =
        document.fonts && document.fonts.load
          ? document.fonts.load('13px "JetBrains Mono"').catch(() => {})
          : Promise.resolve();
      loadMonaco().then(
        (monaco) =>
          fontReady.then(() => {
            clearTimeout(timeout);
            if (fallback) return;
            monacoRef = monaco;
            state.files.forEach((f) => createModel(f.name, f.content));
            applyMonacoTheme();
            $('editor-msg').hidden = true;
            editor = monaco.editor.create($('editor'), {
              model: models[state.active],
              theme: 'code-preview',
              automaticLayout: true,
              fontFamily:
                '"JetBrains Mono", ui-monospace, Menlo, Consolas, monospace',
              fontSize: 13,
              lineHeight: 20,
              tabSize: 2,
              minimap: { enabled: false },
              scrollBeyondLastLine: false,
              padding: { top: 10 },
              renderLineHighlight: 'line',
              smoothScrolling: true,
              wordWrap: 'on',
              fixedOverflowWidgets: true,
            });
            monaco.editor.remeasureFonts();
            // addAction (not addCommand) keeps keybindings scoped to this editor when several are on a page.
            editor.addAction({
              id: 'code-preview-run',
              label: 'Run',
              keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter],
              run: () => run(),
            });
            editor.addAction({
              id: 'code-preview-save',
              label: 'Run (save)',
              keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS],
              run: () => {
                run();
                toast('Ran the preview');
              },
            });
            editor.onDidChangeCursorPosition(updateStatus);
            updateStatus();
          }),
        (err: any) => {
          clearTimeout(timeout);
          startFallback((err && err.message) || 'network error');
        },
      );
    }

    /* ---------- Build ---------- */
    let lastSanitizerReport: string[] = [];
    function buildDoc(withBridge: boolean, nonce?: string) {
      let htmlSrc = getFile('index.html')!.content;
      const DOMPurify = window.DOMPurify;
      lastSanitizerReport = [];
      if (DOMPurify) {
        htmlSrc = DOMPurify.sanitize(htmlSrc, {
          WHOLE_DOCUMENT: true,
          ADD_TAGS: ['meta', 'link', 'title', 'style'],
          ADD_ATTR: [
            'charset',
            'content',
            'name',
            'rel',
            'href',
            'lang',
            'http-equiv',
            'media',
            'target',
          ],
          FORBID_TAGS: ['base'],
        });
        lastSanitizerReport = (DOMPurify.removed || [])
          .map((r: any) => {
            if (r.element && r.element.nodeName)
              return '<' + r.element.nodeName.toLowerCase() + '>';
            if (r.attribute)
              return (
                r.attribute.name +
                ' on <' +
                ((r.from && r.from.nodeName) || '?').toLowerCase() +
                '>'
              );
            return null;
          })
          .filter(Boolean);
      }
      const doc = new DOMParser().parseFromString(htmlSrc, 'text/html');
      if (!doc.querySelector('meta[charset]')) {
        const mc = doc.createElement('meta');
        mc.setAttribute('charset', 'utf-8');
        doc.head.insertBefore(mc, doc.head.firstChild);
      }
      state.files.forEach((f) => {
        if (ext(f.name) !== 'css') return;
        const st = doc.createElement('style');
        st.setAttribute('data-file', f.name);
        st.textContent =
          '\n' + f.content.replace(/<\/style/gi, '<\\/style') + '\n';
        doc.head.appendChild(st);
      });
      state.files.forEach((f) => {
        if (ext(f.name) !== 'js') return;
        const sc = doc.createElement('script');
        sc.setAttribute('data-file', f.name);
        sc.textContent =
          '\n' +
          f.content.replace(/<\/script/gi, '<\\/script') +
          '\n//# sourceURL=' +
          f.name +
          '\n';
        doc.body.appendChild(sc);
      });
      if (withBridge) {
        const br = doc.createElement('script');
        const jsFiles = state.files
          .filter((f) => ext(f.name) === 'js')
          .map((f) => f.name);
        br.textContent =
          '(' +
          bridge.toString() +
          ')(' +
          JSON.stringify(nonce) +
          ',' +
          JSON.stringify(jsFiles) +
          ');';
        doc.head.insertBefore(br, doc.head.firstChild);
      }
      return '<!doctype html>\n' + doc.documentElement.outerHTML;
    }

    /* ---------- Run ---------- */
    let runNonce: string | null = null,
      runTimer: ReturnType<typeof setTimeout> | undefined;
    function scheduleRun() {
      clearTimeout(runTimer);
      setDot('busy');
      runTimer = setTimeout(run, 700);
    }
    function setDot(cls: string) {
      $('run-dot').className = 'status-dot' + (cls ? ' ' + cls : '');
    }
    function run() {
      clearTimeout(runTimer);
      runNonce = Math.random().toString(36).slice(2) + Date.now().toString(36);
      clearConsole(true);
      if (!window.DOMPurify) {
        frame.srcdoc = '';
        logSys(
          "The HTML sanitizer (DOMPurify) didn't load, so the preview won't run. Check your connection and reload the page.",
        );
        setDot('err');
        return;
      }
      let doc;
      try {
        doc = buildDoc(true, runNonce);
      } catch (e: any) {
        logSys('Build failed: ' + e.message);
        setDot('err');
        return;
      }
      if (lastSanitizerReport.length) {
        const uniq = lastSanitizerReport.filter(
          (v, i, a) => a.indexOf(v) === i,
        );
        const hint = getFile('script.js')
          ? ' Put scripts and event handlers in script.js.'
          : '';
        logSys(
          'Sanitizer removed from index.html: ' + uniq.join(', ') + '.' + hint,
        );
      }
      frame.srcdoc = doc;
      setDot('');
    }

    /* ---------- Console ---------- */
    type Entry = {
      level: string;
      args: any[];
      loc: any;
      key: string;
      count: number;
      el: HTMLElement | null;
    };
    let entries: Entry[] = [],
      filter = 'all',
      counts: Record<string, number> = {
        log: 0,
        info: 0,
        warn: 0,
        error: 0,
        sys: 0,
      };
    const ICON: Record<string, string> = {
      log: '›',
      info: 'i',
      warn: '▲',
      error: '✕',
      sys: '·',
    };
    window.addEventListener('message', (e) => {
      const d = e.data;
      if (!d || d.__mc !== runNonce || e.source !== frame.contentWindow) return;
      if (d.level === 'clear') {
        clearConsole(true);
        logSys('Console was cleared by the page');
        return;
      }
      if (['log', 'info', 'warn', 'error'].indexOf(d.level) === -1) return;
      addEntry(d.level, Array.isArray(d.args) ? d.args : [], d.loc);
      if (d.level === 'error') setDot('err');
    });
    function logSys(text: string) {
      addEntry('sys', [{ k: 'str', s: text }], null);
    }
    function addEntry(level: string, args: any[], loc: any) {
      const text = args.map((a) => String(a && a.s)).join(' ');
      const key =
        level + '|' + text + '|' + (loc ? loc.file + ':' + loc.line : '');
      const last = entries[entries.length - 1];
      counts[level] = (counts[level] || 0) + 1;
      if (last && last.key === key) {
        last.count++;
        updateRow(last);
        updateCounts();
        return;
      }
      const en: Entry = { level, args, loc, key, count: 1, el: null };
      entries.push(en);
      if (entries.length > 1000) {
        const old = entries.shift();
        if (old && old.el) old.el.remove();
      }
      const atBottom =
        elLog.scrollHeight - elLog.scrollTop - elLog.clientHeight < 30;
      const empty = elLog.querySelector('.empty');
      if (empty) empty.remove();
      en.el = renderRow(en);
      elLog.appendChild(en.el);
      applyFilter(en);
      updateCounts();
      if (atBottom) elLog.scrollTop = elLog.scrollHeight;
    }
    function renderRow(en: Entry) {
      const row = document.createElement('div');
      row.className = 'row ' + en.level;
      const ico = document.createElement('span');
      ico.className = 'ico';
      ico.textContent = ICON[en.level] || '›';
      ico.setAttribute('aria-label', en.level);
      const msg = document.createElement('span');
      msg.className = 'msg';
      en.args.forEach((a, i) => {
        if (i) msg.appendChild(document.createTextNode(' '));
        const s = document.createElement('span');
        const k = (a && a.k) || 'str';
        s.className = 'a-' + (k === 'str' && i > 0 ? 'str' : k);
        s.textContent = String(a && a.s);
        msg.appendChild(s);
        if (a && a.stack) {
          const st = document.createElement('span');
          st.className = 'stack';
          st.textContent = a.stack;
          msg.appendChild(st);
        }
      });
      const side = document.createElement('span');
      side.className = 'side';
      const c = document.createElement('span');
      c.className = 'count';
      c.hidden = true;
      side.appendChild(c);
      if (en.loc && en.loc.file) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'loc';
        b.textContent = en.loc.file + ':' + en.loc.line;
        b.title = 'Open ' + en.loc.file + ' at line ' + en.loc.line;
        b.addEventListener('click', () => jumpTo(en.loc));
        side.appendChild(b);
      }
      row.append(ico, msg, side);
      return row;
    }
    function updateRow(en: Entry) {
      const c = en.el && (en.el.querySelector('.count') as HTMLElement);
      if (c) {
        c.hidden = false;
        c.textContent = String(en.count);
      }
    }
    function jumpTo(loc: any) {
      if (!getFile(loc.file)) return;
      openFile(loc.file);
      if (editor) {
        editor.revealLineInCenter(loc.line);
        editor.setPosition({ lineNumber: loc.line, column: loc.col || 1 });
        editor.focus();
      } else if (fallback) {
        const lines = fallback.value.split('\n');
        let pos = 0;
        for (let i = 0; i < loc.line - 1 && i < lines.length; i++)
          pos += lines[i].length + 1;
        fallback.focus();
        fallback.setSelectionRange(
          pos,
          pos + (lines[loc.line - 1] || '').length,
        );
      }
    }
    function matches(en: Entry) {
      if (filter === 'all') return true;
      if (filter === 'log') return en.level === 'log' || en.level === 'info';
      return en.level === filter;
    }
    function applyFilter(en: Entry) {
      if (en.el) en.el.hidden = !matches(en);
    }
    function setCount(name: string, n: number) {
      (
        root.querySelector('[data-n="' + name + '"]') as HTMLElement
      ).textContent = String(n);
    }
    function updateCounts() {
      setCount('all', counts.log + counts.info + counts.warn + counts.error);
      setCount('log', counts.log + counts.info);
      setCount('warn', counts.warn);
      setCount('error', counts.error);
    }
    function clearConsole(silent: boolean) {
      entries = [];
      counts = { log: 0, info: 0, warn: 0, error: 0, sys: 0 };
      elLog.innerHTML =
        '<div class="empty">Nothing logged yet. Output from console.log, console.warn and console.error in the preview shows up here.</div>';
      updateCounts();
      if (!silent) logSys('Console cleared');
    }
    const filterBtns = root.querySelectorAll<HTMLElement>('.filter');
    filterBtns.forEach((b) => {
      b.addEventListener('click', () => {
        filter = b.getAttribute('data-f') || 'all';
        filterBtns.forEach((o) =>
          o.setAttribute('aria-pressed', o === b ? 'true' : 'false'),
        );
        entries.forEach(applyFilter);
      });
    });
    $('clear').addEventListener('click', () => clearConsole(false));

    /* ---------- Preview scale ---------- */
    const zoomBtns = root.querySelectorAll<HTMLElement>('.zoom-btn');
    zoomBtns.forEach((b) => {
      b.addEventListener('click', () => {
        frame.style.setProperty('--z', b.getAttribute('data-z') || '1');
        zoomBtns.forEach((o) =>
          o.setAttribute('aria-pressed', o === b ? 'true' : 'false'),
        );
      });
    });
    $('console-toggle').addEventListener('click', () => {
      const btn = $('console-toggle');
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.title = open ? 'Hide console' : 'Show console';
      $('work').classList.toggle('console-collapsed', !open);
      elLog.hidden = !open;
      if (open) elLog.scrollTop = elLog.scrollHeight;
    });
    // Collapsing the preview gives the editor the full width; the preview keeps running while hidden.
    $('preview-toggle').addEventListener('click', () => {
      const btn = $('preview-toggle');
      const open = btn.getAttribute('aria-expanded') !== 'true';
      const label = open ? 'Hide preview' : 'Show preview';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.title = label;
      btn.setAttribute('aria-label', label);
      $('work').classList.toggle('preview-collapsed', !open);
    });

    /* ---------- Export ---------- */
    $('export').addEventListener('click', () => {
      if (!window.DOMPurify) {
        toast(
          "Export needs the HTML sanitizer, which didn't load. Reload the page and try again.",
        );
        return;
      }
      let html;
      try {
        html = buildDoc(false);
      } catch (e: any) {
        toast('Export failed: ' + e.message);
        return;
      }
      const url = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = 'export.html';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      toast('Saved export.html (' + fmtBytes(byteLen(html)) + ')');
    });

    /* ---------- Open in new tab ---------- */
    $('open').addEventListener('click', () => {
      const key = HANDOFF_PREFIX + Math.random().toString(36).slice(2, 10);
      try {
        localStorage.setItem(
          key,
          JSON.stringify(state.files.map((f) => [f.name, f.content])),
        );
      } catch {
        toast("Couldn't hand off your files to a new tab.");
        return;
      }
      window.open(import.meta.env.BASE_URL + 'code-preview/#' + key, '_blank');
    });

    /* ---------- Toast ---------- */
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function toast(text: string) {
      const t = $('toast');
      t.textContent = text;
      t.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (t.hidden = true), 2800);
    }

    /* ---------- Controls ---------- */
    $('reload').addEventListener('click', run);
    root.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        run();
      }
    });

    /* ---------- Boot ---------- */
    renderTabs();
    updateStatus();
    clearConsole(true);
    loadPurify().then(run, run);
    bootMonaco();
  }

  document.querySelectorAll<HTMLElement>('.code-preview').forEach(init);
</script>

<style is:global>
  /* Layout: tabbed editor beside the preview, console spanning underneath. Stacks to one column on narrow screens.

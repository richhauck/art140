  }
  .code-preview .work.preview-collapsed > .preview-pane .label {
    writing-mode: vertical-rl;
  }
  .code-preview .work.preview-collapsed > .preview-pane .btn,
  .code-preview .work.preview-collapsed > .preview-pane .preview-stage,
  .code-preview .work.preview-collapsed > .preview-pane .pane-foot {
    display: none;

    border-right: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    position: relative;
    flex: none;
    cursor: pointer;
  }
  .code-preview .tab.active {
    background: var(--editor-bg);
    color: var(--ink);
  }
  .code-preview .tab.active::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent);
  }
  .code-preview .editor-wrap {

  }
  .code-preview .icon-btn:hover {
    background: var(--line);
    color: var(--ink);
  }
  .code-preview .icon-btn svg {
    width: 14px;
    height: 14px;
  }

  .code-preview .ficon {
    width: 15px;
    height: 15px;
    display: inline-block;
    flex: none;
  }
  .code-preview .ficon svg {

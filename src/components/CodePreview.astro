  }
  .code-preview .btn.btn-sm {
    height: 26px;
    padding: 0 9px;
    gap: 6px;
    font-size: 12px;
    border-radius: 6px;
  }
  .code-preview .btn svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  /* Workspace grid */
  .code-preview .work {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(38px, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(96px, 19%);
    gap: 10px;
    transition: grid-template-columns 0.4s ease;
  }
  .code-preview .console-pane {
    grid-column: 1 / -1;
  }
  .code-preview .work.console-collapsed {
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .code-preview .work.console-collapsed > .console-pane {
    height: auto;
  }
  .code-preview .work.console-collapsed > .console-pane .pane-head {
    border-bottom: 0;
  }
  /* Collapsed preview: a narrow strip holding the toggle and a vertical label. */
  .code-preview .work.preview-collapsed {
    grid-template-columns: minmax(0, 1fr) minmax(38px, 0fr);
  }
  .code-preview .work.preview-collapsed > .preview-pane .pane-head {

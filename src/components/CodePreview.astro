  .code-preview *::after {
    box-sizing: border-box;
  }
  .code-preview button,
  .code-preview input {
    font: inherit;
    color: inherit;
  }
  .code-preview button {
    cursor: pointer;
  }
  .code-preview :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .code-preview [hidden] {
    display: none !important;
  }

  .code-preview .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 12px;

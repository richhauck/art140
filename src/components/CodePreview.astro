    --panel: #fafafa;
    --panel-2: #f3f3f3;
    --line: #dcdcdc;
    --ink: #1a1a1a;
    --muted: #616161;
    --accent: #2b2b2b;
    --accent-ink: #ffffff;
    --accent-soft: rgba(0, 0, 0, 0.06);
    --editor-bg: #fcfcfc;
    --editor-line: #f1f1f1;
    --warn: #8f5a00;
    --warn-bg: #fcf2db;
    --err: #b42318;
    --err-bg: #fcebe9;
    --info: #2463a8;
    --ok: #1f7a4d;
    --t-html: #d0512a;
    --t-css: #2a6fd4;
    --t-js: #a07c00;
    --font-ui:
      'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono:
      'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas,
      monospace;
    --cp-height: 640px;
    color-scheme: light;
  }
  /* The page UI stays light regardless of user preference; only the code area is dark. */
  .code-preview .editor-wrap {
    --bg: #111111;
    --panel: #181818;
    --panel-2: #1e1e1e;
    --line: #2e2e2e;
    --ink: #e8e8e8;
    --muted: #9a9a9a;
    --accent: #dcdcdc;
    --accent-ink: #111111;
    --accent-soft: rgba(255, 255, 255, 0.08);
    --editor-bg: #141414;
    --editor-line: #1c1c1c;
    --warn: #f0b54a;
    --warn-bg: #2b2311;
    --err: #ff7b72;
    --err-bg: #331a1a;
    --info: #7db2f2;
    --ok: #5ccf94;
    --t-html: #f08a5d;
    --t-css: #6ea9ff;
    --t-js: #e6c34a;
    color-scheme: dark;
  }

  .code-preview {
    position: relative;
    height: var(--cp-height);
    display: grid;
    grid-template-rows: minmax(0, 1fr);

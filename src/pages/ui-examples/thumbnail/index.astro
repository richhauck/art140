---
const title = "Thumbnail with Hover";
import Layout from "../../../layouts/Layout.astro";
import CodePreview from "../../../components/CodePreview.astro";
import { thumbnailHover } from "../../../data/codeExamples";
---

<Layout title={title}>
  <p>
    To achieve this effect, you'll use absolute positioning to place both the
    image and the overlay. Then, you'll apply a <code>:hover</code> on the overlay
    to trigger the display of the overlay.
  </p>
  <CodePreview {...thumbnailHover} />
  <p>
    <a
      class="button"
      href={`${import.meta.env.BASE_URL}ui-examples/container/example/index.html`}
      >View Example</a
    >
  </p>
</Layout>

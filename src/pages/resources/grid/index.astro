---
const title = 'Grid';
import Layout from '../../../layouts/Layout.astro';
import { Lightbulb } from '@lucide/astro';
import CodePreview from '../../../components/CodePreview.astro';

const gridHtml = `<h1>Two Column Grid</h1>
<main>
  <header class="grid-header header-bg">
    <div class="inner-header">
      <div class="logo"></div>
      <div class="profile"></div>
    </div>
  </header>
  <article class="col1">col1</article>
  <aside class="col2">col2</aside>
  <footer>Footer</footer>
</main>`;

const gridCss = `:root {
  --white: #fff;
  --boxBg: #ccc;
  --pageBg: #666;
  --basePadding: 20px;
  --baseMargin: 20px;
}
body {
  background-color: var(--pageBg);
  text-align: center;
}
.inner-header {
  background-color: aqua;
}
header, footer, #content, aside {
  padding: var(--basePadding);
}
main {
  padding: var(--basePadding);
  width: 80%;
  margin: 20px auto;
  background-color: var(--white);
  display: grid;
  grid-gap: var(--basePadding);
  grid-template-columns: auto auto 280px;
  grid-template-areas:
    "header header header"
    "col1 col1 col2"
    "footer footer footer";
}
main > * {
  background-color: var(--boxBg);
}
header {
  grid-area: header;
}
footer {
  grid-area: footer;
}
header, footer, article, aside {
  display: flex;
  align-items: center;
  justify-content: center;
}
.col1, .col2 {
  min-height: 200px;
}
.col1 {
  grid-area: col1;
}
.col2 {
  grid-area: col2;
}

.inner-header {
  display: flex;
  justify-content: space-between;
}`;
---

<Layout title={title}>
  <CodePreview html={gridHtml} css={gridCss} />
  <script async src="https://cpwebassets.codepen.io/assets/embed/ei.js"
  ></script>
  <p
    class="codepen"
    data-zoom="0.25"
    data-height="300"
    data-default-tab="html,result"
    data-slug-hash="RwyWjGw"
    data-user="richhauck"
    style="height: 300px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 2px solid; margin: 1em 0; padding: 1em;"
  >
    <span
      >See the Pen <a href="https://codepen.io/richhauck/pen/RwyWjGw">
        Grid Example</a
      > by Rich Hauck (<a href="https://codepen.io/richhauck">@richhauck</a>) on <a
        href="https://codepen.io">CodePen</a
      >.</span
    >
  </p>
  <br />
  <p
    class="codepen"
    data-zoom="0.25"
    data-height="300"
    data-default-tab="html,result"
    data-slug-hash="PoyOegL"
    data-user="richhauck"
    style="height: 300px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 2px solid; margin: 1em 0; padding: 1em;"
  >
    <span
      >See the Pen <a href="https://codepen.io/richhauck/pen/PoyOegL">
        Gallery using CSS grid</a
      > by Rich Hauck (<a href="https://codepen.io/richhauck">@richhauck</a>) on <a
        href="https://codepen.io">CodePen</a
      >.</span
    >
  </p>

  <aside>
    <h3><Lightbulb /> Tips:</h3>
    <ul>
      <li>
        <a href="https://css-tricks.com/snippets/css/complete-guide-grid/"
          >CSS-Tricks: A Complete Guide to Grid</a
        >
        <li>
          <a href="https://www.w3schools.com/css/css3_flexbox.asp"
            >CSS Flexbox</a
          >
          <li>
            <a
              href="https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Grids"
              >MDN Guide to Grid</a
            >
          </li>
        </li>
      </li>
    </ul>
  </aside>
</Layout>

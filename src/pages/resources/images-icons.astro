---
const title = 'Stock Images and Icons';
import Layout from '../../layouts/Layout.astro';
import {
  Image,
  SquareDashed,
  Library,
  Bot,
  Palette,
  PencilRuler,
} from '@lucide/astro';
---

<Layout title={title} fullWidth={false}>
  <grid-container size="lg">
    <grid-row>
      <grid-col span="6" span-lg="4"
        ><h2><Image /> Free Stock Images</h2>
        <ul>
          <li>
            <a href="https://search.creativecommons.org/">Creative Commons</a>
          </li>
          <li><a href="https://www.pexels.com/">Pexels</a></li>
          <li><a href="https://unsplash.com/">Unsplash</a></li>
          <li><a href="https://openverse.org/">Openverse</a></li>
        </ul></grid-col
      >
      <grid-col span="6" span-lg="4"
        ><h2><SquareDashed /> Image Placeholders</h2>
        <ul>
          <li><a href="https://placehold.co/">Placehold</a></li>
          <li><a href="http://pravatar.cc/">Pravatar</a></li>
          <li><a href="https://picsum.photos/">Picsum</a></li>
        </ul></grid-col
      >
      <grid-col span="6" span-lg="4"
        ><h2><Library /> Icon Libraries</h2>
        <ul>
          <li><a href="https://fontawesome.com/">Font Awesome</a></li>
          <li>
            <a href="https://fonts.google.com/icons">Google Material Icons</a>
          </li>
          <li><a href="https://lucide.dev/">Lucide</a></li>
          <li>
            <a href="https://zurb.com/playground/foundation-icon-fonts-3"
              >Foundation Icons</a
            >
          </li>
          <li><a href="https://feathericons.com/">Feather Icons</a></li>
          <li>
            <a href="https://thenounproject.com/">The Noun Project</a>
          </li>
          <li><a href="https://www.snoweb-svg.com/en/">Snoweb</a></li>
          <li><a href="https://www.svgrepo.com/">SVG Repo</a></li>
          <li><a href="https://symbols.wentin.net/">Symbols to Copy</a></li>
          <li><a href="https://icondash.com/">IconDash</a></li>
        </ul></grid-col
      >
    </grid-row>
    <grid-row>
      <grid-col span="6" span-md="4"
        ><h2><Bot />AI-Generated Images</h2>
        <ul>
          <li>
            <a href="https://stablediffusionweb.com/">Stabled Diffusion</a>
          </li>
          <li><a href="https://loremfaces.com/">LoremFaces</a></li>
          <li>
            <a href="https://www.adobe.com/sensei/generative-ai/firefly.html"
              >Adobe Firefly</a
            >
          </li>
        </ul></grid-col
      >
      <grid-col span="6" span-md="4"
        ><h2><Palette /> Color Palette</h2>
        <ul>
          <li><a href="http://colormind.io/">Colormind</a></li>
          <li><a href="https://coolors.co/">Coolors</a></li>
          <li>
            <a href="https://meodai.github.io/poline/"
              >Poline (color palette generator)</a
            >
          </li>
          <li><a href="https://themer.dev/">Themer</a></li>
          <li><a href="https://color.adobe.com">Adobe Color</a></li>
        </ul></grid-col
      >
      <grid-col span="6" span-md="4">
        <h2><PencilRuler /> Tools:</h2>
        <ul>
          <li>
            <a href="https://realfavicongenerator.net">Favicon Generator</a>
          </li>
          <li><a href="http://www.svgs.us/">SVGSUS</a></li>
          <li>
            <a href="http://creativedo.co/FontAwesomePS">Font Awesome PS</a> - Adobe
            Photoshop plugin for icons
          </li>
        </ul>
      </grid-col>
    </grid-row>
  </grid-container>
</Layout>

<style>
  grid-container {
    padding-inline: 0;
  }
  grid-row + grid-row {
    margin-top: 1rem;
  }
  grid-col {
    background-color: #fff;
    border: 1px solid var(--borderColor);
    border-top: 6px solid var(--red);
    padding: 0 1.25rem 1rem;
    transition: var(--transition);
  }
  grid-col:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--borderColor);
    font-size: 1.25rem;
  }
  ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  li {
    margin-bottom: 0.35rem;
  }
</style>

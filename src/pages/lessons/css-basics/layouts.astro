---
const title = "CSS Layouts";
import Layout from "../../../layouts/Layout.astro";
import { Lightbulb } from "@lucide/astro";
import CodePreview from "../../../components/CodePreview.astro";
import {
  flexRowsColumns,
  flexEqualColumns,
  flexGallery,
  gridTwoColumn,
  gridGallery,
  float,
} from "../../../data/codeExamples";
---

<Layout title={title}>
  {/*
  <h2>z-Index</h2>
  <CodePreview {...zIndex} />
  */}

  <h2>Flex</h2>
  <p>Simple example creating rows and columns.</p>
  <CodePreview {...flexRowsColumns} />
  <br />
  <p>Example using flex-basis to create equally-sized columns.</p>
  <CodePreview {...flexEqualColumns} />
  <br />
  <CodePreview {...flexGallery} />

  <aside>
    <h3><Lightbulb /> Tips:</h3>
    <ul>
      <li>
        <a href="https://css-tricks.com/snippets/css/a-guide-to-flexbox/"
          >CSS-Tricks: A Complete Guide to Flexbox</a
        >
        <li>
          <a href="https://www.w3schools.com/css/css3_flexbox.asp"
            >CSS Flexbox</a
          >
          <li>
            <a
              href="https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Flexbox"
              >MDN Guide to Flexbox</a
            >
          </li>
        </li>
      </li>
    </ul>
  </aside>
  <h2>Grid</h2>
  <CodePreview {...gridTwoColumn} />
  <br />
  <CodePreview {...gridGallery} />

  <aside>
    <h3><Lightbulb /> Tips:</h3>
    <ul>
      <li>
        <a href="https://css-tricks.com/snippets/css/complete-guide-grid/"
          >CSS-Tricks: A Complete Guide to Grid</a
        >
        <li>
          <a href="https://www.w3schools.com/css/css3_flexbox.asp"
            >CSS Flexbox</a
          >
          <li>
            <a
              href="https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Grids"
              >MDN Guide to Grid</a
            >
          </li>
        </li>
      </li>
    </ul>
  </aside>
  <h3>Float</h3>
  <CodePreview {...float} />
</Layout>
